# ========================================
# 医疗报告系统 v2.0 环境变量配置
# ========================================
# 复制此文件为 .env 并修改配置

# ----------------------------------------
# 数据库配置 (PostgreSQL)
# ----------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<必须修改: 设置强密码>
DB_NAME=medical_report

# ----------------------------------------
# Redis配置
# ----------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<必须修改: 设置强密码>

# ----------------------------------------
# 安全配置 (必填)
# ----------------------------------------
# 生产环境请使用强密钥 (至少32字符)
# 生成命令: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production-must-be-at-least-32-chars

# 管理员初始密码（首次部署时创建默认 admin 账号使用，留空则使用默认密码 admin123）
ADMIN_INITIAL_PASSWORD=

# PHI加密密钥 (生产环境必填)
# 生成命令: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# ⚠️ 生产环境必须配置 ENCRYPTION_KEY 并保持 false
ALLOW_UNENCRYPTED_PHI=false

# ----------------------------------------
# LLM 配置 (OpenAI 兼容协议) —— 可选回退
# ----------------------------------------
# 推荐方式：部署后登录系统，在「个人中心 → AI 配置」菜单中配置并测试（加密存库、保存后热生效）。
# 以下环境变量留空不影响启动，仅作为未使用菜单配置时的回退。
# 本地 AI 解读与知识库摘要使用的 LLM
LLM_API_KEY=
LLM_API_BASE=http://127.0.0.1:3456
LLM_MODEL_NAME=glm-5

# OCR 专用 LLM
OCR_LLM_API_KEY=
OCR_LLM_API_BASE=https://api.openai.com/v1
OCR_LLM_MODEL_NAME=gpt-4o

# 指标解读专用 LLM (留空则回退到 LLM_*)
INTERPRETATION_LLM_API_KEY=
INTERPRETATION_LLM_API_BASE=
INTERPRETATION_LLM_MODEL_NAME=
INTERPRETATION_LLM_TIMEOUT=

# ----------------------------------------
# 应用配置
# ----------------------------------------
DEBUG=false

# ----------------------------------------
# 前端端口 (宿主机映射)
# ----------------------------------------
FRONTEND_PORT=3000
FRONTEND_BIND_ADDRESS=127.0.0.1

# ----------------------------------------
# CORS 配置 (前端访问地址)
# ----------------------------------------
CORS_ORIGINS=["http://localhost","http://localhost:3000"]

# ----------------------------------------
# 文件存储配置
# ----------------------------------------
# 存储类型: local (本地文件系统) / minio (未来扩展)
STORAGE_TYPE=local
# 存储根目录
# - Docker 环境: 必须使用 /app/storage（对应 docker-compose.yml 中的 app_storage volume）
# - 本地开发: 默认为 storage（项目根目录下的 storage 目录，可自定义绝对路径）
STORAGE_PATH=/app/storage

# ----------------------------------------
# 备份配置
# ----------------------------------------
BACKUP_DIR=./backups
